# Neon Postgres connection string
DATABASE_URL=
# Upstash Redis REST credentials
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Bright Data API token (Web Scraper API)
BRIGHTDATA_API_KEY=
# Max live Bright Data lookups per day (protects the 5,000 free credits/month)
DAILY_SEARCH_CAP=100
# 32+ random chars, signs session JWTs
JWT_SECRET=
# 64 hex chars (32 bytes), encrypts booking data at rest: openssl rand -hex 32
ENCRYPTION_KEY=
# Public site URL, used in email links and the sitemap
APP_URL=http://localhost:3000
# Random string; the scheduled refresh sends it as a Bearer token
CRON_SECRET=
# Resend (optional locally: emails are printed to the server log when unset)
RESEND_API_KEY=
MAIL_FROM=Flight Finder <onboarding@resend.dev>
